# App Postgres, started from services/app/db/lunch.
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pdf_reader

# Chatbot Postgres, started from services/chatbot/docker-compose.yml.
CHATBOT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/chatbot

# Uploaded books written by services/app. Parsed JSON sits next to each file.
LOCAL_STORAGE_PATH=../app/storage

# Chat model. The OpenAI adapter sends the session messages and returns the reply.
# A local server accepts any non-empty key. OpenRouter needs its own key.
OPENAI_API_KEY=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
OPENAI_MODEL=google/gemini-2.5-flash
# API root. Leave empty for the official OpenAI API.
# Local example: http://127.0.0.1:8092/v1
# OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Browser origins allowed to call this API.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Chatbot Postgres container started by services/chatbot/docker-compose.yml.
CHATBOT_POSTGRES_USER=postgres
CHATBOT_POSTGRES_PASSWORD=postgres
CHATBOT_POSTGRES_DB=chatbot
CHATBOT_POSTGRES_PORT=5433
