# OpenAI-compatible vLLM endpoint that serves PaddleOCR.
VLLM_OPENAI_ENDPOINT=http://127.0.0.1:8092/

# Optional. Set these when the server requires a model name or an API key.
VLLM_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
VLLM_API_KEY=

# How many page images to send at the same time.
OCR_CONCURRENCY=10

# Uploaded books written by services/app. A relative path starts at this directory.
LOCAL_STORAGE_PATH=../app/storage

RABBITMQ_URL=amqp://pdf_reader:pdf_reader@localhost:5672/

# App Postgres. After a book is parsed the worker sets books.is_parsed = true.
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pdf_reader

# RabbitMQ and vLLM containers started by services/parsing/docker-compose.yml.
RABBITMQ_USER=pdf_reader
RABBITMQ_PASSWORD=pdf_reader
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
VLLM_PORT=8092
VLLM_MODEL_REPO=PaddlePaddle/PaddleOCR-VL-1.6
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_BATCHED_TOKENS=4096
VLLM_MAX_NUM_SEQS=2
VLLM_MM_PROCESSOR_CACHE_GB=0
