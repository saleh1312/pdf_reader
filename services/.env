# Values used by services/docker-compose.yml.
# Hostnames are the compose service names. The .env file inside each service
# keeps localhost for running that process on the host.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pdf_reader
POSTGRES_PORT=5432

CHATBOT_POSTGRES_USER=postgres
CHATBOT_POSTGRES_PASSWORD=postgres
CHATBOT_POSTGRES_DB=chatbot
CHATBOT_POSTGRES_PORT=5433

RABBITMQ_USER=pdf_reader
RABBITMQ_PASSWORD=pdf_reader
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

VLLM_PORT=8092
VLLM_MODEL_REPO=PaddlePaddle/PaddleOCR-VL-1.6
VLLM_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
# 8 GB laptop GPU. One page image, a short context, and room left for the KV cache.
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_BATCHED_TOKENS=4096
VLLM_MAX_NUM_SEQS=2
VLLM_MM_PROCESSOR_CACHE_GB=0

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/pdf_reader
RABBITMQ_URL=amqp://pdf_reader:pdf_reader@rabbitmq:5672/
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/pdf_reader
CHATBOT_DATABASE_URL=postgresql+psycopg://postgres:postgres@chatbot-postgres:5432/chatbot
VLLM_OPENAI_ENDPOINT=http://vllm:8092/
VLLM_API_KEY=
OCR_CONCURRENCY=10
LOCAL_STORAGE_PATH=/storage
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
