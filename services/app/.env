# Directory for uploaded PDF and Word files.
# A relative path is resolved from this file's directory (services/app).
LOCAL_STORAGE_PATH=storage

# App Postgres, started from services/app/db/lunch.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pdf_reader

# Broker that receives parse requests. Started from services/parsing.
RABBITMQ_URL=amqp://pdf_reader:pdf_reader@localhost:5672/

# Browser origins allowed to call this API.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
