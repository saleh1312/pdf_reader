@startuml sign_in_sequence
title Sign in

skinparam shadowing false
skinparam sequenceMessageAlign center
hide footbox
autonumber

actor Client
participant Application
participant "Sign in service" as Service
database DB

Client -> Application : sign in (username, password)
Application -> Service : SignIn
Service -> DB : find user by username
DB --> Service : user or none

alt user not found or wrong password
  Service --> Application : invalid credentials
  Application --> Client : error
else credentials match
  Service --> Application : user id
  Application --> Client : user id
end

@enduml
