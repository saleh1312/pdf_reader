@startuml sign_up_sequence
title Sign up

skinparam shadowing false
skinparam sequenceMessageAlign center
hide footbox
autonumber

actor Client
participant Application
participant "Sign up service" as Service
database DB

Client -> Application : sign up (name, username, password)
Application -> Service : SignUp
Service -> DB : find user by username
DB --> Service : result

alt username already taken
  Service --> Application : username taken
  Application --> Client : error
else username is free
  Service -> Service : hash password
  Service -> DB : save new user
  Service --> Application : user id
  Application --> Client : user id
end

@enduml
